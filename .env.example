# The publishable key is sent to the auth client at runtime. Never substitute
# a secret or service-role key. Row Level Security must protect user data.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional public Cloudflare Turnstile site key. Enable Supabase CAPTCHA only
# after all clients pass a captcha token to Auth.
TURNSTILE_SITE_KEY=

# Server-only hosted Notificator API endpoint.
NOTIFICATOR_API_URL=https://api.notificator-project.com

# Optional override for device commands and transient HiveMQ connection tests.
WPNOTIF_API_URL=https://wpnotif.notificator-project.com/.netlify/functions/wpnotif-api

# Optional fixed official signed firmware catalog override.
FIRMWARE_MANIFEST_URL=https://wpnotif.notificator-project.com/firmware/manifest.json
